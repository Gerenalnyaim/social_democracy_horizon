@party_list
new-page: true

= Created Parties

[? if not Q.custom_parties or Q.custom_parties.length == 0:
No parties created yet.
?]

[? if Q.custom_parties and Q.custom_parties.length > 0:

{!
var partyListHTML = "<table style='width:100%; border-collapse: collapse;'><tr style='border-bottom: 2px solid #333;'><td style='padding:8px; font-weight:bold;'>Name</td><td style='padding:8px; font-weight:bold;'>Position</td><td style='padding:8px; font-weight:bold;'>Ideology</td><td style='padding:8px; font-weight:bold;'>Color</td><td style='padding:8px; font-weight:bold;'>Leader</td></tr>";

Q.custom_parties.forEach(function(party, index) {
    var ideologyLabel = "";
    if (party.position <= -75) ideologyLabel = "Far-Left";
    else if (party.position <= -50) ideologyLabel = "Left";
    else if (party.position <= -25) ideologyLabel = "Centre-Left";
    else if (party.position <= 5) ideologyLabel = "Centre";
    else if (party.position <= 25) ideologyLabel = "Centre-Right";
    else if (party.position <= 50) ideologyLabel = "Right";
    else ideologyLabel = "Far-Right";
    
    partyListHTML += "<tr style='border-bottom: 1px solid #ccc;'>";
    partyListHTML += "<td style='padding:8px;'>" + party.name + "</td>";
    partyListHTML += "<td style='padding:8px; text-align:center;'>" + party.position + "</td>";
    partyListHTML += "<td style='padding:8px;'>" + ideologyLabel + "</td>";
    partyListHTML += "<td style='padding:8px;'><div style='display:inline-block; background-color:rgb(" + party.color.r + "," + party.color.g + "," + party.color.b + "); width:30px; height:30px; border:1px solid #333;'></div> #" + party.color_hex + "</td>";
    partyListHTML += "<td style='padding:8px;'>" + (party.leader || "-") + "</td>";
    partyListHTML += "</tr>";
});

partyListHTML += "</table>";
Q.party_list_html = partyListHTML;
!}

{![+ Q.party_list_html +]!}

**Total Parties Created:** [+ Q.custom_parties.length +]

?]

- @create_basic: Create New Party
- @menu: Back
