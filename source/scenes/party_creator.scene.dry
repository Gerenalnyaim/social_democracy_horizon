title: Party Creator
new-page: true
go-to: menu
on-arrival: {!
window.enableFocusMode()
!}

= Party Creator

Create custom political parties for sandbox mode with custom colors and political positions.

@menu

- @create_basic: Create a New Party
- @preset_parties: Browse Preset Parties
- @party_list: View Created Parties
- @backSpecialScene: Back to Library

@create_basic
new-page: true

= Create a New Party

Define your party's characteristics below:

**Party Name:**
[!
Q.new_party_name = Q.new_party_name || "";
!]

- @color_input: Choose Party Color (RGB)

**Political Position:**
Drag the slider to position your party on the left-right spectrum.

- @position_input: Set Political Position

- @party_options: Additional Options
- @create_party: Create Party
- @menu: Cancel

@color_input
new-page: true

= Choose Party Color

Select your party's color using RGB values (0-255 for each channel).

[!
Q.party_r = Q.party_r || 200;
Q.party_g = Q.party_g || 50;
Q.party_b = Q.party_b || 50;
!]

Red (0-255): [+ Q.party_r +]

[? if Q.show_color_preview:
<div style="display: inline-block; background-color: rgb([+Q.party_r+], [+Q.party_g+], [+Q.party_b+]); width: 100px; height: 100px; border: 2px solid #333; margin: 10px 0;"></div>
?]

- **Adjust Red:**
  - @red_increase: Increase Red
  - @red_decrease: Decrease Red

Green (0-255): [+ Q.party_g +]

- **Adjust Green:**
  - @green_increase: Increase Green
  - @green_decrease: Decrease Green

Blue (0-255): [+ Q.party_b +]

- **Adjust Blue:**
  - @blue_increase: Increase Blue
  - @blue_decrease: Decrease Blue

Color Preview (Hex): #[!
var toHex = function(n) { return n.toString(16).padStart(2, '0'); };
Q.party_color_hex = toHex(Q.party_r) + toHex(Q.party_g) + toHex(Q.party_b);
!][+ Q.party_color_hex +]

- @position_input: Continue to Position
- @create_basic: Back

@red_increase
on-arrival: {!
Q.party_r = Math.min(255, Q.party_r + 10);
Q.show_color_preview = 1;
!}
go-to: color_input

@red_decrease
on-arrival: {!
Q.party_r = Math.max(0, Q.party_r - 10);
Q.show_color_preview = 1;
!}
go-to: color_input

@green_increase
on-arrival: {!
Q.party_g = Math.min(255, Q.party_g + 10);
Q.show_color_preview = 1;
!}
go-to: color_input

@green_decrease
on-arrival: {!
Q.party_g = Math.max(0, Q.party_g - 10);
Q.show_color_preview = 1;
!}
go-to: color_input

@blue_increase
on-arrival: {!
Q.party_b = Math.min(255, Q.party_b + 10);
Q.show_color_preview = 1;
!}
go-to: color_input

@blue_decrease
on-arrival: {!
Q.party_b = Math.max(0, Q.party_b - 10);
Q.show_color_preview = 1;
!}
go-to: color_input

@position_input
new-page: true

= Set Political Position

Position your party on the political spectrum from -100 (Far Left) to +100 (Far Right).

[!
Q.party_position = Q.party_position || 0;

var getIdeologyLabel = function(pos) {
    if (pos <= -75) return "Far-Left Communist";
    if (pos <= -50) return "Left Socialist";
    if (pos <= -25) return "Centre-Left Progressive";
    if (pos <= -5) return "Centre-Left";
    if (pos <= 5) return "Centre";
    if (pos <= 25) return "Centre-Right";
    if (pos <= 50) return "Right Conservative";
    if (pos <= 75) return "Far-Right";
    return "Ultra-Right";
};

Q.party_ideology = getIdeologyLabel(Q.party_position);
!}

Current Position: [+ Q.party_position +]

Ideology: **[+ Q.party_ideology +]**

- **Move Left:**
  - @position_far_left: Far Left (-100)
  - @position_left: Left (-50)
  - @position_center_left: Centre-Left (-25)

- **Center:**
  - @position_center: Centre (0)

- **Move Right:**
  - @position_center_right: Centre-Right (+25)
  - @position_right: Right (+50)
  - @position_far_right: Far-Right (+85)

- @party_options: Continue to Options
- @color_input: Back to Color Selection

@position_far_left
on-arrival: {!
