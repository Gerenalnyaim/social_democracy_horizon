@start
on-arrival: {!
// Add SPD party name system
Q.spd_custom_name = "SPD";

// Function to update party name throughout the game
Q.update_party_name_in_events = function() {
    // This function gets called whenever events are displayed
    // The custom name will be accessible via [+ spd_custom_name +] in events
    console.log("Party name updated to: " + Q.spd_custom_name);
};

// Helper function to get party name for dynamic text
Q.get_party_name = function() {
    return Q.spd_custom_name || "SPD";
};

// time elapsed (in months)
Q.time = 0;
Q.year = 1927;
Q.month = 11;
// how many actions have been taken this month?
Q.month_actions = 0;
if (!Q.rng_seed) {
    Q.rng_seed = Date.now() & 0xFFFFFFFF;
}

// ========================================
// HINDENBURG & CAMARILLA VARIABLES
// ========================================

// === HINDENBURG PERSONAL STATE ===
Q.hindenburg_president = 0;
Q.hindenburg_health = 100;
Q.hindenburg_age = 78;
Q.hindenburg_senility = 0;
Q.hindenburg_stubbornness = 75;
Q.hindenburg_trust_reichstag = 50;
Q.hindenburg_trust_military = 85;
Q.hindenburg_trust_spd = 30;
Q.hindenburg_trust_z = 60;
Q.hindenburg_trust_dnvp = 70;
Q.hindenburg_monarchist_sentiment = 65;

// === CAMARILLA (INNER CIRCLE) ===
Q.camarilla_exists = 0;
Q.camarilla_strength = 0;
Q.camarilla_unified = 0;

// Individual camarilla member influence (0-100 each)
Q.meissner_influence = 0;
Q.schleicher_influence = 0;
Q.oskar_influence = 0;
Q.oldenburg_influence = 0;
Q.papen_influence = 0;
Q.hugenberg_influence = 0;

// Camarilla member status
Q.meissner_exposed = 0;
Q.schleicher_exposed = 0;
Q.oskar_bribed = 0;
Q.oskar_convinced = 0;
Q.papen_in_camarilla = 0;
Q.oldenburg_scandal = 0;

// === CAMARILLA GOALS ===
Q.camarilla_goal_destroy_parliament = 0;
Q.camarilla_goal_install_papen = 0;
Q.camarilla_goal_military_dictatorship = 0;
Q.camarilla_goal_restore_monarchy = 0;
Q.camarilla_goal_crush_left = 0;
Q.camarilla_goal_protect_junkers = 0;
Q.camarilla_goal_install_hitler = 0;

// === PRESIDENTIAL CRISIS TRACKING ===
Q.hindenburg_crisis_threshold = 0;
Q.hindenburg_interventions = 0;
Q.hindenburg_reichstag_dissolutions = 0;
Q.hindenburg_government_dismissals = 0;

// === PRESIDENTIAL CABINET ERA ===
Q.presidential_cabinet = 0;
Q.presidential_cabinet_count = 0;
Q.bruning_cabinet = 0;
Q.papen_cabinet = 0;
Q.schleicher_cabinet = 0;
Q.bruning_dismissed = 0;
Q.papen_dismissed = 0;

// === KEY CAMARILLA PLOTS ===
Q.schleicher_bruning_plot = 0;
Q.schleicher_bruning_plotted = 0;
