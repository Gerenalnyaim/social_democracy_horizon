Q.france_relation = -1;
Q.italy_relation = 0;
Q.hungary_relation = 0;
Q.poland_relation = 0;
Q.czech_relation = 0;
Q.austria_relation = 0;

// International situation
Q.ruhr_labor = 0;
Q.tyrole_signed = 0;
Q.young_plan_catastrophy = 0;
Q.austria_govt = 1;

// 0 = normal difficulty, 1 = hard mode, 2 = hard mode no saves
Q.difficulty = 0;
Q.historical_mode = 0;
Q.old_demographics = 0;
Q.use_decimals = 0;

// party resources
Q.resources = 2;
Q.dues = 2;

// the state of the party
Q.dissent = 0.05;
Q.dissent_percent = 5;

// factions
Q.factions = ['left', 'center', 'labor', 'reformist', 'neorevisionist'];
Q.left_strength = 12;
Q.left_dissent = 20;
Q.center_strength = 33;
Q.center_dissent = 0;
Q.labor_strength = 25;
Q.labor_dissent = 5;
Q.reformist_strength = 25;
Q.reformist_dissent = 5;
Q.neorevisionist_strength = 5;
Q.neorevisionist_dissent = 10;

// SPLIT EVENTS or OTHER
Q.unions_independent = 0;
Q.centrists_resign = 0;
Q.left_split = 0;
Q.reformists_resigned = 0;
Q.sapd_formed = 0;
Q.neorevisionism = 0;
Q.srpd_formed = 0;
Q.neorev_split = 0;

// crisis_urgency indicates how seriously the SPD is taking the economic crisis - scale from 0 to 10.
Q.crisis_urgency = 0;
// nazi_urgency indicates how seriously the SPD takes the nazis - scale from 0 to 10.
Q.nazi_urgency = 0;
// radicalization indicates how radical the SPD's rhetoric is - scale from 0 to 10.
Q.radicalization = 0;
Q.wtb_support = 0;
Q.pacifism = 0;
Q.democratization = 0;
Q.communist_coalition = 0;
Q.economic_plan = 0;
Q.wtb_adopted = 0;
Q.iron_front_formed = 0;
Q.peoples_party_support = 0;
Q.nationalization_support = 0;
Q.nationalization_adopted = 0;
Q.moderate_plan_support = 0;
Q.moderate_plan_adopted = 0;

// organizations
Q.kpd_ideology = "Marxism-Leninism";
Q.kpo_ideology = "Council Communism";
Q.sl_ideology = "Revolutionary Socialism";
Q.sapd_ideology = "Left-Wing Socialism";
Q.spd_ideology = "Social Democracy";
Q.srpd_ideology = "Social Republicanism";
Q.ddp_ideology = "Social Liberalism";
Q.z_ideology = "Catholic Tent";
