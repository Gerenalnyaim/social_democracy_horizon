// === OSTHILFE SCANDAL ===
Q.osthilfe_scandal = 0;
Q.osthilfe_exposed = 0;
Q.osthilfe_investigation = 0;
Q.osthilfe_cover_up = 0;
Q.hindenburg_estate_neudeck = 0;

// === ALTERNATIVE CHANCELLORS ===
Q.goerdeler_prominence = 0;
Q.goerdeler_chancellor_possible = 0;
Q.hammerstein_coup_ready = 0;
Q.hammerstein_coup_attempted = 0;
Q.hammerstein_coup_success = 0;

// === SCHLEICHER'S QUERFRONT ===
Q.schleicher_querfront_attempt = 0;
