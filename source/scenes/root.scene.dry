// === PAPEN DICTATORSHIP ATTEMPT ===
Q.papen_dictatorship_attempt = 0;
Q.papen_second_term = 0;
Q.cabinet_of_barons = 0;
Q.center_split_risk = 0;

// === MILITARY EMERGENCY GOVERNMENT ===
Q.military_emergency_government = 0;
Q.military_dictatorship = 0;
Q.military_dictatorship_brewing = 0;
Q.article_48_permanent = 0;

// === NAZI APPOINTMENT ===
Q.nazi_takeover_begins = 0;
Q.hugenberg_hitler_pact = 0;
Q.vice_chancellor = "";
Q.vice_chancellor_party = "";

// === SPD COUNTER-STRATEGIES ===
Q.hindenburg_relationship_efforts = 0;
Q.camarilla_counter_efforts = 0;
