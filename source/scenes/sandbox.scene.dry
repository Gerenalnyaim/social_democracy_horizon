title: sandbox
new-page: true
is-special: true
is-hand: true
go-to: sandbox_menu

= Sandbox Menu

@sandbox_menu

- @sandbox_party_rename.party_rename_menu: Change Party Name
- @debug: Debug Console
- @developermode: Developer Mode

@party_rename_menu
title: Change Party Name

Current party name: **[+ spd_custom_name +]**

- @party_rename_input: Change party name
- @party_rename_reset: Reset to default (SPD)
- @sandbox_menu: Back

@party_rename_input
on-display: {!
var container = document.getElementById('party-rename-input-container');
if (!container) {
    container = document.createElement('div');
    container.id = 'party-rename-input-container';
    document.body.appendChild(container);
}

container.innerHTML = '';
container.style.cssText = 'margin: 20px 0; padding: 15px; background: #f5f5f5; border-radius: 5px;';

var label = document.createElement('label');
label.textContent = 'Enter new party name: ';
label.style.cssText = 'display: block; margin-bottom: 10px; font-weight: bold;';

var input = document.createElement('input');
input.type = 'text';
input.placeholder = 'Enter new party name...';
input.value = Q.spd_custom_name || 'SPD';
input.id = 'spd-name-input';
input.style.cssText = 'background:#fff; color:#000; border:2px solid #333; padding:8px 12px; font-family:Arial; font-size:14px; width:300px; border-radius:4px; margin-bottom: 10px;';

var confirmBtn = document.createElement('button');
confirmBtn.textContent = 'Confirm';
confirmBtn.style.cssText = 'background:#333; color:#fff; border:none; padding:8px 16px; font-family:Arial; font-size:14px; cursor:pointer; border-radius:4px; margin-right: 10px;';

var cancelBtn = document.createElement('button');
cancelBtn.textContent = 'Cancel';
cancelBtn.style.cssText = 'background:#999; color:#fff; border:none; padding:8px 16px; font-family:Arial; font-size:14px; cursor:pointer; border-radius:4px;';

confirmBtn.addEventListener('click', function() {
    var newName = input.value.trim();
    if (newName.length > 0 && newName.length <= 50) {
        Q.spd_custom_name = newName;
        console.log("Party renamed to: " + Q.spd_custom_name);
        container.innerHTML = '<p style="color: green; font-weight: bold;">✓ Party renamed to <strong>' + Q.spd_custom_name + '</strong></p>';
        setTimeout(function() {
            window.dendryUI.dendryEngine.goToScene('party_rename_menu');
        }, 1500);
    } else {
        var errorMsg = document.createElement('p');
        errorMsg.textContent = '✗ Name must be between 1-50 characters.';
        errorMsg.style.cssText = 'color: red; margin-top: 10px;';
        container.appendChild(errorMsg);
    }
});

cancelBtn.addEventListener('click', function() {
    window.dendryUI.dendryEngine.goToScene('party_rename_menu');
});

container.appendChild(label);
container.appendChild(input);
container.appendChild(document.createElement('br'));
container.appendChild(confirmBtn);
container.appendChild(cancelBtn);
!}

**Enter a new name for your party (max 50 characters):**

{!<div id="party-rename-input-container"></div>!}

- @party_rename_menu: Back

@party_rename_reset
on-arrival: spd_custom_name = "SPD"

Party name reset to **SPD**.

- @party_rename_menu: Back

@debug
on-arrival: {!

console.log("=== SANDBOX DEBUG ===");

// 1. PARTIES ARRAY
console.log("1. Q.parties:", JSON.stringify(Q.parties));
console.log("1. Q.parties length:", Q.parties ? Q.parties.length : "UNDEFINED");

// 2. CLASS SUPPORT VARIABLES
var debug_classes = ['workers', 'old_middle', 'new_middle', 'rural', 'unemployedc'];
var debug_parties = Q.parties ? Q.parties.filter(function(p){ return p !== 'other'; }) : [];
var debug_missing = [];
var debug_nan = [];
var debug_zero = [];

for (var di = 0; di < debug_parties.length; di++) {
    for (var dj = 0; dj < debug_classes.length; dj++) {
        var debug_key = debug_classes[dj] + '_' + debug_parties[di];
        var debug_val = Q[debug_key];
        if (debug_val === undefined || debug_val === null) debug_missing.push(debug_key);
        else if (isNaN(debug_val)) debug_nan.push(debug_key + '=NaN');
        else if (debug_val === 0) debug_zero.push(debug_key + '=0');
    }
}

console.log("2. MISSING class vars:", JSON.stringify(debug_missing));
console.log("2. NaN class vars:", JSON.stringify(debug_nan));
console.log("2. Zero class vars:", JSON.stringify(debug_zero));

// 3. CRITICAL VARS
var crit_list = ['workers','old_middle','new_middle','rural','unemployed',
    'nationalism','socialism','pro_republic',
    'spd_r','kpd_r','z_r','ddp_r','dvp_r','dnvp_r','nsdap_r',
    'budget','resources','dissent'];
for (var cri = 0; cri < crit_list.length; cri++) {
    var crit_val = Q[crit_list[cri]];
    if (crit_val === undefined) console.log("3. MISSING: " + crit_list[cri]);
    else if (isNaN(crit_val)) console.log("3. NaN: " + crit_list[cri]);
    else console.log("3. OK: " + crit_list[cri] + " =", crit_val);
}

console.log("=== DEBUG COMPLETE ===");
!}

Debug information has been logged to the console.

- @sandbox_menu: Back

@developermode
on-display: {!
if (Q.developer_mode) {
    document.getElementById('dev-console').innerHTML =
        '<p style="color:lime;font-family:monospace;">✓ Developer mode active.</p>';
    return;
}

var container = document.getElementById('dev-console');
container.innerHTML = '';

var input = document.createElement('input');
input.type        = 'password';
input.placeholder = 'Enter access code…';
input.style.cssText =
    'background:#111; color:#0f0; border:1px solid #0f0;' +
    'padding:6px 10px; font-family:monospace; font-size:13px;' +
    'width:220px; outline:none; border-radius:2px;';

var btn = document.createElement('button');
btn.textContent  = 'Confirm';
btn.style.cssText =
    'margin-left:8px; background:#0f0; color:#000; border:none;' +
    'padding:6px 12px; font-family:monospace; font-size:13px;' +
    'cursor:pointer; border-radius:2px;';

var msg = document.createElement('p');
msg.style.cssText = 'color:#f55; font-size:12px; margin-top:6px; height:16px;';

btn.addEventListener('click', function() {
    if (input.value === '1920Luxembourg') {
        Q.developer_mode = 1;
        container.innerHTML =
            '<p style="color:lime;font-family:monospace;">✓ Access granted. Developer mode enabled.</p>';
    } else {
        msg.textContent = '✗ Incorrect code.';
        input.value = '';
    }
});

input.addEventListener('keydown', function(e) {
    if (e.key === 'Enter') btn.click();
});

container.appendChild(input);
container.appendChild(btn);
container.appendChild(msg);

!}

= Developer Console

{!<div id="dev-console"></div>!}

[? if developer_mode = 1 : **Developer mode is active.** ?]

- @sandbox_menu: Back
